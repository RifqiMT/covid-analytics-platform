{
  "name": "covid-analytics-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "build": "next build",
    "build:clean": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --pretty false --noUnusedLocals --noUnusedParameters",
    "test": "vitest run"
  },
  "dependencies": {
    "csv-parse": "^6.2.1",
    "date-fns": "^4.1.0",
    "i18n-iso-countries": "^7.13.0",
    "leaflet": "^1.9.4",
    "next": "^16.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.13.3",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^4.1.3"
  }
}
